<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.senac.beautyscheduledesk.UsuarioController">
    <children>
        <Button layoutX="37.0" layoutY="341.0" mnemonicParsing="false" onAction="#onVoltarButtonClick" prefHeight="25.0" prefWidth="57.0" text="Voltar" />

        <Label layoutX="60.0" layoutY="33.0" prefHeight="17.0" prefWidth="39.0" text="Nome" />
        <TextField fx:id="txtUsername" layoutX="60.0" layoutY="56.0" prefHeight="25.0" prefWidth="255.0" />

        <Label layoutX="325.0" layoutY="33.0" text="Senha" />
        <PasswordField fx:id="txtSenha" layoutX="325.0" layoutY="56.0" prefHeight="25.0" prefWidth="231.0" />

        <Button layoutX="114.0" layoutY="341.0" mnemonicParsing="false" onAction="#onSalvarButtonClick" prefHeight="25.0" prefWidth="100.0" text="Salvar" />

        <Label layoutX="60.0" layoutY="98.0" text="CEP" />
        <TextField fx:id="txtCep" layoutX="60.0" layoutY="117.0" />
        <Button layoutX="214.0" layoutY="117.0" mnemonicParsing="false" onAction="#onBuscarCepClick" prefHeight="25.0" prefWidth="100.0" text="Buscar CEP" />

        <Label layoutX="326.0" layoutY="160.0" prefHeight="17.0" prefWidth="45.0" text="Cidade" />
        <TextField fx:id="txtCidade" disable="true" layoutX="325.0" layoutY="181.0" prefHeight="25.0" prefWidth="231.0" />

        <Label layoutX="61.0" layoutY="160.0" prefHeight="17.0" prefWidth="39.0" text="Rua" />
        <TextField fx:id="txtLogradouro" disable="true" layoutX="60.0" layoutY="181.0" prefHeight="25.0" prefWidth="255.0" />

        <Label layoutX="60.0" layoutY="217.0" prefHeight="17.0" prefWidth="51.0" text="Bairro" />
        <TextField fx:id="txtBairro" disable="true" layoutX="60.0" layoutY="241.0" prefHeight="25.0" prefWidth="255.0" />

    </children>
</AnchorPane>
