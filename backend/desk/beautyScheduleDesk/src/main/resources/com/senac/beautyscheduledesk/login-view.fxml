<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            fx:controller="com.senac.beautyscheduledesk.LoginController"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <children>

       <Label layoutX="184.0" layoutY="112.0" prefHeight="36.0" prefWidth="52.0" text="Login" />
       <TextField fx:id="txtLogin" layoutX="184.0" layoutY="148.0" prefHeight="25.0" prefWidth="231.0" />

       <Label layoutX="184.0" layoutY="182.0" prefHeight="36.0" prefWidth="52.0" text="Senha" />
       <PasswordField fx:id="txtSenha" layoutX="185.0" layoutY="218.0" prefHeight="25.0" prefWidth="231.0" />

       <Button onAction="#onLoginButtonClick" layoutX="254.0" layoutY="333.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="89.0" text="Entrar" />
   </children>
</AnchorPane>
